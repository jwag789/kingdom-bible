":"the","s":1.4,"e":1.5},{"w":"brothers","s":1.5,"e":1.962},{"w":"saw","s":1.962,"e":2.212},{"w":"Joseph","s":2.212,"e":2.725},{"w":"coming","s":2.725,"e":3.013},{"w":"in","s":3.013,"e":3.087},{"w":"his","s":3.087,"e":3.25},{"w":"coat","s":3.25,"e":4.05},{"w":"They","s":4.188,"e":4.375},{"w":"took","s":4.375,"e":4.575},{"w":"the","s":4.575,"e":4.675},{"w":"coat","s":4.675,"e":4.925},{"w":"away","s":4.925,"e":5.537},{"w":"and","s":5.537,"e":5.675},{"w":"put","s":5.675,"e":5.912},{"w":"Joseph","s":5.912,"e":6.4},{"w":"down","s":6.4,"e":6.688},{"w":"into","s":6.688,"e":6.925},{"w":"an","s":6.925,"e":7.062},{"w":"empty","s":7.062,"e":7.425},{"w":"well","s":7.425,"e":8.1}]},"sold-1":{"src":"audio/joseph/sold-1.m4a","text":"Then some traders came by with their camels, on their way to Egypt. The brothers sold Joseph to them, and the traders took him far, far away.","voice":"af_heart,af_bella","duration":10.275,"words":[{"w":"Then","s":0.6,"e":0.812},{"w":"some","s":0.812,"e":1.025},{"w":"traders","s":1.025,"e":1.475},{"w":"came","s":1.475,"e":1.725},{"w":"by","s":1.725,"e":1.95},{"w":"with","s":1.95,"e":2.087},{"w":"their","s":2.087,"e":2.25},{"w":"camels","s":2.25,"e":3},{"w":"on","s":3.1,"e":3.237},{"w":"their","s":3.237,"e":3.425},{"w":"way","s":3.425,"e":3.6},{"w":"to","s":3.6,"e":3.737},{"w":"Egypt","s":3.737,"e":4.675},{"w":"The","s":4.838,"e":4.95},{"w":"brothers","s":4.95,"e":5.412},{"w":"sold","s":5.412,"e":5.787},{"w":"Joseph","s":5.787,"e":6.275},{"w":"to","s":6.275,"e":6.4},{"w":"them","s":6.4,"e":6.9},{"w":"and","s":7,"e":7.112},{"w":"the","s":7.112,"e":7.2},{"w":"traders","s":7.2,"e":7.675},{"w":"took","s":7.675,"e":7.838},{"w":"him","s":7.838,"e":8.05},{"w":"far","s":8.05,"e":8.55},{"w":"far","s":8.662,"e":8.95},{"w":"away","s":8.95,"e":9.7}]},"sold-2":{"src":"audio/joseph/sold-2.m4a","text":"Joseph was all alone. But he wasn’t really alone at all. God was with him.","voice":"af_heart,af_bella","duration":6.1,"words":[{"w":"Joseph","s":0.675,"e":1.1},{"w":"was","s":1.1,"e":1.288},{"w":"all","s":1.288,"e":1.55},{"w":"alone","s":1.55,"e":2.175},{"w":"But","s":2.25,"e":2.388},{"w":"he","s":2.388,"e":2.5},{"w":"wasn't","s":2.5,"e":2.812},{"w":"really","s":2.812,"e":3.15},{"w":"alone","s":3.15,"e":3.462},{"w":"at","s":3.462,"e":3.55},{"w":"all","s":3.55,"e":4.075},{"w":"God","s":4.225,"e":4.6},{"w":"was","s":4.6,"e":4.775},{"w":"with","s":4.775,"e":4.963},{"w":"him","s":4.963,"e":5.525}]},"egypt-title":{"src":"audio/joseph/egypt-title.m4a","text":"Part Four. God Was With Joseph.","voice":"af_heart,af_bella","duration":3.575,"words":[{"w":"Part","s":0.6,"e":0.85},{"w":"Four","s":0.85,"e":1.35},{"w":"God","s":1.488,"e":1.788},{"w":"Was","s":1.788,"e":1.938},{"w":"With","s":1.938,"e":2.138},{"w":"Joseph","s":2.138,"e":3}]},"egypt-0":{"src":"audio/joseph/egypt-0.m4a","text":"In Egypt, hard things kept happening to Joseph. He was even put in prison when he hadn’t done anything wrong. But God was with him the whole time.","voice":"af_heart,af_bella","duration":10.275,"words":[{"w":"In","s":0.65,"e":0.787},{"w":"Egypt","s":0.787,"e":1.375},{"w":"hard","s":1.488,"e":1.85},{"w":"things","s":1.85,"e":2.25},{"w":"kept","s":2.25,"e":2.525},{"w":"happening","s":2.525,"e":2.95},{"w":"to","s":2.95,"e":3.087},{"w":"Joseph","s":3.087,"e":4.05},{"w":"He","s":4.15,"e":4.263},{"w":"was","s":4.263,"e":4.362},{"w":"even","s":4.362,"e":4.65},{"w":"put","s":4.65,"e":4.838},{"w":"in","s":4.838,"e":4.975},{"w":"prison","s":4.975,"e":5.362},{"w":"when","s":5.362,"e":5.487},{"w":"he","s":5.487,"e":5.6},{"w":"hadn't","s":5.6,"e":5.85},{"w":"done","s":5.85,"e":6.075},{"w":"anything","s":6.075,"e":6.5},{"w":"wrong","s":6.5,"e":7.275},{"w":"But","s":7.375,"e":7.537},{"w":"God","s":7.537,"e":7.95},{"w":"was","s":7.95,"e":8.125},{"w":"with","s":8.125,"e":8.3},{"w":"him","s":8.3,"e":8.525},{"w":"the","s":8.525,"e":8.625},{"w":"whole","s":8.625,"e":8.887},{"w":"time","s":8.887,"e":9.7}]},"egypt-1":{"src":"audio/joseph/egypt-1.m4a","text":"One night, Pharaoh, 