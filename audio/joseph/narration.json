,"e":12.475},{"w":"him","s":12.475,"e":13.125}]},"forgive-1":{"src":"audio/joseph/forgive-1.m4a","text":"Joseph couldn’t keep it in any longer. He cried and cried. “I am Joseph, your brother!” His brothers were so scared!","voice":"af_heart,af_bella","duration":8.325,"words":[{"w":"Joseph","s":0.65,"e":1.075},{"w":"couldn't","s":1.075,"e":1.3},{"w":"keep","s":1.3,"e":1.538},{"w":"it","s":1.538,"e":1.613},{"w":"in","s":1.613,"e":1.688},{"w":"any","s":1.688,"e":1.875},{"w":"longer","s":1.875,"e":2.5},{"w":"He","s":2.6,"e":2.763},{"w":"cried","s":2.763,"e":3.163},{"w":"and","s":3.163,"e":3.275},{"w":"cried","s":3.275,"e":4.025},{"w":"I","s":4.275,"e":4.425},{"w":"am","s":4.425,"e":4.6},{"w":"Joseph","s":4.6,"e":5.125},{"w":"your","s":5.162,"e":5.275},{"w":"brother","s":5.275,"e":5.875},{"w":"His","s":6,"e":6.2},{"w":"brothers","s":6.2,"e":6.588},{"w":"were","s":6.588,"e":6.737},{"w":"so","s":6.737,"e":6.963},{"w":"scared","s":6.963,"e":7.725}]},"forgive-2":{"src":"audio/joseph/forgive-2.m4a","text":"But Joseph hugged every one of them. “Don’t be afraid,” he said. “You meant to hurt me, but God meant it for good.” And the whole family was together again.","voice":"af_heart,af_bella","duration":10.9,"words":[{"w":"But","s":0.575,"e":0.713},{"w":"Joseph","s":0.713,"e":1.238},{"w":"hugged","s":1.238,"e":1.663},{"w":"every","s":1.663,"e":2},{"w":"one","s":2,"e":2.138},{"w":"of","s":2.138,"e":2.25},{"w":"them","s":2.25,"e":2.875},{"w":"Don't","s":3.075,"e":3.263},{"w":"be","s":3.263,"e":3.4},{"w":"afraid","s":3.4,"e":4.075},{"w":"he","s":4.225,"e":4.388},{"w":"said","s":4.388,"e":4.925},{"w":"You","s":5.125,"e":5.225},{"w":"meant","s":5.225,"e":5.388},{"w":"to","s":5.388,"e":5.475},{"w":"hurt","s":5.475,"e":5.75},{"w":"me","s":5.75,"e":6},{"w":"but","s":6.075,"e":6.237},{"w":"God","s":6.237,"e":6.6},{"w":"meant","s":6.6,"e":6.812},{"w":"it","s":6.812,"e":6.925},{"w":"for","s":6.925,"e":7.075},{"w":"good","s":7.075,"e":7.85},{"w":"And","s":8,"e":8.162},{"w":"the","s":8.162,"e