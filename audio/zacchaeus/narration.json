},{"w":"lost","s":5.675,"e":6.175},{"w":"and","s":6.225,"e":6.338},{"w":"to","s":6.338,"e":6.463},{"w":"save","s":6.463,"e":6.825},{"w":"them","s":6.825,"e":7.375}]},"talk":{"src":"audio/zacchaeus/talk.m4a","text":"Let’s talk about it. Nobody liked Zacchaeus. Why do you think Jesus wanted to go to his house? How did Zacchaeus change after he met Jesus? Is there someone who feels left out that you could be kind to? Our memory verse is Luke 19, verse 10. For the Son of Man came to seek and to save the lost.","voice":"af_heart,af_bella","duration":20.05,"words":[{"w":"Let's","s":0.625,"e":0.875},{"w":"talk","s":0.875,"e":1.113},{"w":"about","s":1.113,"e":1.4},{"w":"it","s":1.4,"e":1.775},{"w":"Nobody","s":1.9,"e":2.275},{"w":"liked","s":2.275,"e":2.6},{"w":"Zacchaeus","s":2.6,"e":3.6},{"w":"Why","s":3.712,"e":3.862},{"w":"do","s":3.862,"e":3.962},{"w":"you","s":3.962,"e":4.05},{"w":"think","s":4.05,"e":4.287},{"w":"Jesus","s":4.287,"e":4.725},{"w":"wanted","s":4.725,"e":4.963},{"w":"to","s":4.963,"e":5.05},{"w":"go","s":5.05,"e":5.225},{"w":"to","s":5.225,"e":5.312},{"w":"his","s":5.312,"e":5.475},{"w":"house","s":5.475,"e":6.175},{"w":"How","s":6.312,"e":6.525},{"w":"did","s":6.525,"e":6.7},{"w":"Zacchaeus","s":6.7,"e":7.188},{"w":"change","s":7.188,"e":7.65},{"w":"after","s":7.65,"e":7.912},{"w":"he","s":7.912,"e":8},{"w":"met","s":8,"e":8.213},{"w":"Jesus","s":8.213,"e":9.175},{"w":"Is","s":9.3,"e":9.5},{"w":"there","s":9.5,"e":9.713},{"w":"someone","s":9.713,"e":10.037},{"w":"who","s":10.037,"e":10.188},{"w":"feels","s":10.188,"e":10.55},{"w":"left","s":10.55,"e":10.8},{"w":"out","s":10.8,"e":11.05},{"w":"that","s":11.05,"e":11.175},{"w":"you","s":11.175,"e":11.3},{"w":"could","s":11.3,"e":11.412},{"w":"be","s":11.412,"e":11.562},{"w":"kind","s":11.562,"e":11.938},{"w":"to","s":11.938,"e":12.3},{"w":"Our","s":12.688,"e":12.887},{"w":"memory","s":12.887,"e":13.325},{"w":"verse","s":13.325,"e":13.7},{"w":"is","s":13.7,"e":13.85},{"w":"Luke","s":13.85,"e":14.075},{"w"