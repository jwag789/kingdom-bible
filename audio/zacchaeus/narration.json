.4},{"w":"up","s":5.4,"e":5.975}]},"tree-2":{"src":"audio/zacchaeus/tree-2.m4a","text":"“Zacchaeus, hurry down! I’m going to stay at your house today!” Zacchaeus scrambled down as fast as he could. He was so happy!","voice":"af_heart,af_bella","duration":8.825,"words":[{"w":"Zacchaeus","s":0.65,"e":1.2},{"w":"hurry","s":1.25,"e":1.525},{"w":"down","s":1.525,"e":2.025},{"w":"I'm","s":2.1,"e":2.237},{"w":"going","s":2.237,"e":2.413},{"w":"to","s":2.413,"e":2.5},{"w":"stay","s":2.5,"e":2.712},{"w":"at","s":2.712,"e":2.788},{"w":"your","s":2.788,"e":2.9},{"w":"house","s":2.9,"e":3.2},{"w":"today","s":3.2,"e":3.9},{"w":"Zacchaeus","s":4.188,"e":4.713},{"w":"scrambled","s":4.713,"e":5.3},{"w":"down","s":5.3,"e":5.65},{"w":"as","s":5.65,"e":5.8},{"w":"fast","s":5.8,"e":6.138},{"w":"as","s":6.138,"e":6.213},{"w":"he","s":6.213,"e":6.338},{"w":"could","s":6.338,"e":6.925},{"w":"He","s":7.05,"e":7.162},{"w":"was","s":7.162,"e":7.3},{"w":"so","s":7.3,"e":7.5},{"w":"happy","s":7.5,"e":8.25}]},"dinner-title":{"src":"audio/zacchaeus/dinner-title.m4a","text":"Part Four. A Brand-New Heart.","voice":"af_heart,af_bella","duration":3.25,"words":[{"w":"Part","s":0.6,"e":0.875},{"w":"Four","s":0.875,"e":1.325},{"w":"A","s":1.45,"e":1.55},{"w":"Brand-New","s":1.55,"e":2.05},{"w":"Heart","s":2.05,"e":2.675}]},"dinner-0":{"src":"audio/zacchaeus/dinner-0.m4a","text":"The people grumbled. “Why is Jesus going to that man’s house? He’s a cheater!”","voice":"af_heart,af_bella","duration":6,"words":[{"w":"The","s":0.575,"e":0.65},{"w":"people","s":0.65,"e":1.025},{"w":"grumbled","s":1.025,"e":1.875},{"w":"Why","s":2.1,"e":2.3},{"w":"is","s":2.3,"e":2.462},{"w":"Jesus","s":2.462,"e":2.925},{"w":"going","s":2.925,"e":3.138},{"w":"to","s":3.138,"e":3.212},{"w":"that","s":3.212,"e":3.4},{"w":"man's","s":3.4,"e":3.75},{"w":"house","s":3.75,"e":4.3},{"w":"He's","s":4.4,"e":4.588},{"w":"a","s":4.588,"e":4.688},{"w":"cheater","s":4.688,"e":5.4}]},"dinner-1":{"src":"audio/zacchaeus/dinner-1.m4a","text":"