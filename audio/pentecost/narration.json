},{"w":"be","s":9.65,"e":10.1},{"w":"they","s":10.275,"e":10.438},{"w":"said","s":10.438,"e":11.025},{"w":"They're","s":11.25,"e":11.4},{"w":"all","s":11.4,"e":11.6},{"w":"from","s":11.6,"e":11.8},{"w":"Galilee","s":11.8,"e":12.65}]},"church-title":{"src":"audio/pentecost/church-title.m4a","text":"Part Five. The First Church.","voice":"af_heart,af_bella","duration":3.175,"words":[{"w":"Part","s":0.6,"e":0.875},{"w":"Five","s":0.875,"e":1.375},{"w":"The","s":1.475,"e":1.575},{"w":"First","s":1.575,"e":1.875},{"w":"Church","s":1.875,"e":2.575}]},"church-0":{"src":"audio/pentecost/church-0.m4a","text":"Peter told the crowd all about Jesus, and how He died and rose again so everyone could be forgiven. That very day, about three thousand people believed and were baptized!","voice":"af_heart,af_bella","duration":12.625,"words":[{"w":"Peter","s":0.575,"e":0.925},{"w":"told","s":0.925,"e":1.188},{"w":"the","s":1.188,"e":1.275},{"w":"crowd","s":1.275,"e":1.7},{"w":"all","s":1.7,"e":1.863},{"w":"about","s":1.863,"e":2.188},{"w":"Jesus","s":2.188,"e":3.1},{"w":"and","s":3.2,"e":3.325},{"w":"how","s":3.325,"e":3.525},{"w":"He","s":3.525,"e":3.688},{"w":"died","s":3.688,"e":4.125},{"w":"and","s":4.125,"e":4.25},{"w":"rose","s":4.25,"e":4.625},{"w":"again","s":4.625,"e":5.275},{"w":"so","s":5.275,"e":5.513},{"w":"everyone","s":5.513,"e":6.025},{"w":"could","s":6.025,"e":6.138},{"w":"be","s":6.138,"e":6.287},{"w":"forgiven","s":6.287,"e":7.275},{"w":"That","s":7.475,"e":7.763},{"w":"very","s":7.763,"e":8.075},{"w":"day","s":8.075,"e":8.575},{"w":"about","s":8.675,"e":9.025},{"w":"three","s":9.025,"e":9.363},{"w":"thousand","s":9.363,"e":9.825},{"w":"people","s":9.825,"e":10.2},{"w":"believed","s":10.2,"e":10.775},{"w":"and","s":10.775,"e":10.887},{"w":"were","s":10.887,"e":11},{"w":"baptized","s":11,"e":12.05}]},"church-1":{"src":"audio/pentecost/church-1.m4a","text":"The new believers met together every day. They prayed, they learned about Jesus, they shared their food and everything they had, and they praised God with glad hearts.","voice":"af_heart,af_bella","duration":11.6,"words":[{"w":"The","s":0.6,"e":0.7},{"w":"new","s":0.7,"e":0.875},{"w":"believers","s":0.875,"e":1.488},{"w":"met","s":1.488,"e":1.7},{"w":"together","s":1.7,"e":2.138},{"w":"every","s":2.138,"e":2.475},{"w":"day","s":2.475,"e":3.225},{"w":"They","s":3.413,"e":3.612},{"w":"prayed","s":3.612,"e":4.25},{"w":"they","s":4.35,"e":4.5},{"w":"learned","s":4.5,"e":4.787},{"w":"about","s":4.787,"e":5.088},{"w":"Jesus","s":5.088,"e":5.875},{"w":"they","s":5.975,"e":6.15},{"w":"shared","s":6.15,"e":6.438},{"w":"their","s":6.438,"e":6.625},{"w":"food","s":6.625,"e":7.075},{"w":"and","s":7.075,"e":7.237},{"w":"everything","s":7.237,"e":7.7},{"w":"they","s":7.7,"e":7.85},{"w":"had","s":7.85,"e":8.5},{"w":"and","s":8.6,"e":8.713},{"w":"they","s":8.713,"e":8.863},{"w":"praised","s":8.863,"e":9.312},{"w":"God","s":9.312,"e":9.725},{"w":"with","s":9.725,"e":9.912},{"w":"glad","s":9.912,"e":10.3},{"w":"hearts","s":10.3,"e":11.025}]},"church-2":{"src":"audio/pentecost/church-2.m4a","text":"This was the very first church! And every day, more and more people came to know Jesus. The good news was beginning to spread all over the world.","voice":"af_heart,af_bella","duration":10.3,"words":[{"w":"This","s":0.6,"e":0.85},{"w":"was","s":0.85,"e":1.05},{"w":"the","s":1.05,"e":1.188},{"w":"very","s":1.188,"e":1.538},{"w":"first","s":1.538,"e":1.887},{"w":"church","s":1.887,"e":2.625},{"w":"And","s":2.75,"e":2.9},{"w":"every","s":2.9,"e":3.225},{"w":"day","s":3.225,"e":3.65},{"w":"more","s":3.763,"e":4.037},{"w":"and","s":4.037,"e":4.15},{"w":"more","s":4.15,"e":4.375},{"w":"people","s":4.375,"e":4.75},{"w":"came","s":4.75,"e":5.025},{"w":"to","s":5.025,"e":5.125},{"w":"know","s":5.125,"e":5.312},{"w":"Jesus","s":5.312,"e":6.3},{"w":"The","s":6.438,"e":6.588},{"w":"good","s":6.588,"e":6.862},{"w":"news","s":6.862,"e":7.275},{"w":"was","s":7.275,"e":7.45},{"w":"beginning","s":7.45,"e":7.825},{"w":"