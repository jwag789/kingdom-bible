ke","s":4.875,"e":5.037},{"w":"a","s":5.037,"e":5.15},{"w":"mighty","s":5.15,"e":5.625},{"w":"rushing","s":5.713,"e":6.125},{"w":"wind","s":6.125,"e":6.875},{"w":"It","s":7.025,"e":7.237},{"w":"filled","s":7.237,"e":7.5},{"w":"the","s":7.5,"e":7.6},{"w":"whole","s":7.6,"e":7.85},{"w":"house","s":7.85,"e":8.65},{"w":"Whoosh","s":8.838,"e":9.65}]},"wind-2":{"src":"audio/pentecost/wind-2.m4a","text":"Little flames, like fire, came and rested over each one of them. They were all filled with the Holy Spirit, and they began to speak in other languages!","voice":"af_heart,af_bella","duration":10.625,"words":[{"w":"Little","s":0.625,"e":0.9},{"w":"flames","s":0.9,"e":1.525},{"w":"like","s":1.562,"e":1.788},{"w":"fire","s":1.788,"e":2.4},{"w":"came","s":2.538,"e":2.875},{"w":"and","s":2.875,"e":3},{"w":"rested","s":3,"e":3.425},{"w":"over","s":3.425,"e":3.725},{"w":"each","s":3.725,"e":3.975},{"w":"one","s":3.975,"e":4.112},{"w":"of","s":4.112,"e":4.225},{"w":"them","s":4.225,"e":4.975},{"w":"They","s":5.138,"e":5.287},{"w":"were","s":5.287,"e":5.438},{"w":"all","s":5.438,"e":5.775},{"w":"filled","s":5.775,"e":6.138},{"w":"with","s":6.138,"e":6.263},{"w":"the","s":6.263,"e":6.362},{"w":"Holy","s":6.362,"e":6.763},{"w":"Spirit","s":6.763,"e":7.475},{"w":"and","s":7.575,"e":7.688},{"w":"they","s":7.688,"e":7.825},{"w":"began","s":7.825,"e":8.162},{"w":"to","s":8.162,"e":8.287},{"w":"speak","s":8.287,"e":8.637},{"w":"in","s":8.637,"e":8.775},{"w":"other","s":8.775,"e":9.075},{"w":"languages","s":9.075,"e":10.05}]},"crowd-title":{"src":"audio/pentecost/crowd-title.m4a","text":"Part Four. Everyone Understood.","voice":"af_heart,af_bella","duration":3.375,"words":[{"w":"Part","s":0.6,"e":0.85},{"w":"Four","s":0.85,"e":1.325},{"w":"Everyone","s":1.462,"e":1.887},{"w":"Understood","s":1.887,"e":2.775}]},"crowd-0":{"src":"audio/pentecost/crowd-0.m4a","text":"Jerusalem was full of visitors from many different countries. When they heard the noise, a big crowd came running to see what w