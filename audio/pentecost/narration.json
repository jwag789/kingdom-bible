{"cover":{"src":"audio/pentecost/cover.m4a","text":"The Spirit Comes.","voice":"af_heart,af_bella","duration":2.475,"words":[{"w":"The","s":0.625,"e":0.725},{"w":"Spirit","s":0.725,"e":1.125},{"w":"Comes","s":1.125,"e":1.875}]},"forty-title":{"src":"audio/pentecost/forty-title.m4a","text":"Part One. Forty Wonderful Days.","voice":"af_heart,af_bella","duration":3.55,"words":[{"w":"Part","s":0.6,"e":0.85},{"w":"One","s":0.85,"e":1.275},{"w":"Forty","s":1.425,"e":1.775},{"w":"Wonderful","s":1.775,"e":2.175},{"w":"Days","s":2.175,"e":2.95}]},"forty-0":{"src":"audio/pentecost/forty-0.m4a","text":"After Jesus came back to life, He stayed with His friends for forty days. He ate with them, talked with them, and showed them again and again that He was really alive!","voice":"af_heart,af_bella","duration":11.575,"words":[{"w":"After","s":0.625,"e":0.963},{"w":"Jesus","s":0.963,"e":1.425},{"w":"came","s":1.425,"e":1.65},{"w":"back","s":1.65,"e":1.925},{"w":"to","s":1.925,"e":2.05},{"w":"life","s":2.05,"e":2.675},{"w":"He","s":2.775,"e":2.925},{"w":"stayed","s":2.925,"e":3.263},{"w":"with","s":3.263,"e":3.388},{"w":"His","s":3.388,"e":3.575},{"w":"friends","s":3.575,"e":4},{"w":"for","s":4,"e":4.175},{"w":"forty","s":4.175,"e":4.55},{"w":"days","s":4.55,"e":5.475},{"w":"He","s":5.612,"e":5.8},{"w":"ate","s":5.8,"e":6.013},{"w":"with","s":6.013,"e":6.175},{"w":"them","s":6.175,"e":6.55},{"w":"talked","s":6.662,"e":7.013},{"w":"with","s":7.013,"e":7.175},{"w":"them","s":7.175,"e":7.675},{"w":"and","s":7.775,"e":7.925},{"w":"showed","s":7.925,"e":8.188},{"w":"them","s":8.188,"e":8.325},{"w":"again","s":8.325,"e":8.725},{"w":"and","s":8.725,"e":8.838},{"w":"again","s":8.838,"e":9.275},{"w":"that","s":9.275,"e":9.425},{"w":"He","s":9.425,"e":9.6},{"w":"was","s":9.6,"e":9.8},{"w":"really","s":9.8,"e":10.175},{"w":"alive","s":10.175,"e":11}]},"forty-1":{"src":"audio/pentecost/forty-1.m4a","text":"“Stay in Jerusalem and wait,” Jesus told them. “Soon God will send you the Holy Spirit, t