"Again","s":0.6,"e":0.875},{"w":"God","s":0.875,"e":1.175},{"w":"said","s":1.175,"e":1.425},{"w":"Go","s":1.575,"e":1.725},{"w":"to","s":1.725,"e":1.825},{"w":"Nineveh","s":1.825,"e":2.5},{"w":"And","s":2.725,"e":2.888},{"w":"this","s":2.888,"e":3.075},{"w":"time","s":3.075,"e":3.45},{"w":"Jonah","s":3.513,"e":3.85},{"w":"went","s":3.85,"e":4.475}]},"nineveh-1":{"src":"audio/jonah/nineveh-1.m4a","text":"“In forty days, Nineveh will be destroyed!” he called out through the streets. And the people listened.","voice":"af_heart,af_bella","duration":7.025,"words":[{"w":"In","s":0.625,"e":0.775},{"w":"forty","s":0.775,"e":1.125},{"w":"days","s":1.125,"e":1.625},{"w":"Nineveh","s":1.7,"e":2.025},{"w":"will","s":2.025,"e":2.138},{"w":"be","s":2.138,"e":2.275},{"w":"destroyed","s":2.275,"e":3.15},{"w":"he","s":3.3,"e":3.45},{"w":"called","s":3.45,"e":3.712},{"w":"out","s":3.712,"e":3.925},{"w":"through","s":3.925,"e":4.112},{"w":"the","s":4.112,"e":4.2},{"w":"streets","s":4.2,"e":4.95},{"w":"And","s":5.05,"e":5.188},{"w":"the","s":5.188,"e":5.275},{"w":"people","s":5.275,"e":5.65},{"w":"listened","s":5.65,"e":6.45}]},"nineveh-2":{"src":"audio/jonah/nineveh-2.m4a","text":"Everyone, even the king, said sorry to God and stopped doing wrong. And God forgave them all.","voice":"af_heart,af_bella","duration":7.25,"words":[{"w":"Everyone","s":0.625,"e":1.125},{"w":"even","s":1.2,"e":1.462},{"w":"the","s":1.462,"e":1.562},{"w":"king","s":1.562,"e":2.1},{"w":"said","s":2.225,"e":2.475},{"w":"sorry","s":2.475,"e":2.775},{"w":"to","s":2.775,"e":2.9},{"w":"God","s":2.9,"e":3.325},{"w":"and","s":3.325,"e":3.45},{"w":"stopped","s":3.45,"e":3.8},{"w":"doing","s":3.8,"e":4.1},{"w":"wrong","s":4.1,"e":4.825},{"w":"And","s":4.95,"e":5.138},{"w":"God","s":5.138,"e":5.5},{"w":"forgave","s":5.5,"e":5.888},{"w":"them","s":5.888,"e":6.05},{"w":"all","s":6.05,"e":6.675}]},"vine-title":{"src":"audio/jonah/vine-title.m4a","text":"Part Five. Jonah’s Plant.","voice":"af_heart,af_bella","duration":3.225,"words":[{"w":"Part","s":0.6,"e":0.875},{"w":"Five","s":0.875,"e":1.4},{"w":"Jonah's","s":1.538,"e":1.9},{"w":"Plant","s":1.9,"e":2.65}]},"vine-0":{"src":"audio/jonah/vine-0.m4a","text":"But Jonah was angry. He didn’t want God to forgive his enemies! So he sat outside the city to sulk in the hot sun.","voice":"af_heart,af_bella","duration":8.4,"words":[{"w":"But","s":0.575,"e":0.75},{"w":"Jonah","s":0.75,"e":1.2},{"w":"was","s":1.2,"e":1.413},{"w":"angry","s":1.413,"e":2.175},{"w":"He","s":2.3,"e":2.413},{"w":"didn't","s":2.413,"e":2.612},{"w":"want","s":2.612,"e":2.812},{"w":"God","s":2.812,"e":3.175},{"w":"to","s":3.175,"e":3.275},{"w":"forgive","s":3.275,"e":3.587},{"w":"his","s":3.587,"e":3.75},{"w":"enemies","s":3.75,"e":4.675},{"w":"So","s":4.812,"e":4.975},{"w":"he","s":4.975,"e":5.112},{"w":"sat","s":5.112,"e":5.338},{"w":"outside","s":5.338,"e":5.763},{"w":"the","s":5.763,"e":5.862},{"w":"city","s":5.862,"e":6.2},{"w":"to","s":6.2,"e":6.35},{"w":"sulk","s":6.35,"e":6.688},{"w":"in","s":6.688,"e":6.763},{"w":"the","s":6.763,"e":6.85},{"w":"hot","s":6.85,"e":7.138},{"w":"sun","s":7.138,"e":7.825}]},"vine-1":{"src":"audio/jonah/vine-1.m4a","text":"So God made a leafy plant grow up over Jonah to give him shade. Jonah was very happy about the plant.","voice":"af_heart,af_bella","duration":7.775,"words":[{"w":"So","s":0.6,"e":0.787},{"w":"God","s":0.787,"e":1.2},{"w":"made","s":1.2,"e":1.387},{"w":"a","s":1.387,"e":1.488},{"w":"leafy","s":1.488,"e":1.863},{"w":"plant","s":1.863,"e":2.288},{"w":"grow","s":2.288,"e":2.538},{"w":"up","s":2.538,"e":2.688},{"w":"over","s":2.688,"e":2.938},{"w":"Jonah","s":2.938,"e":3.375},{"w":"to","s":3.375,"e":3.475},{"w":"give","s":3.475,"e":3.612},{"w":"him","s":3.612,"e":3.8},{"w":"shade","s":3.8,"e":4.625},{"w":"Jonah","s":4.838,"e":5.225},{"w":"was","s":5.225,"e":5.412},{"w":"very","s":5.412,"e":5.725},{"w":"happy","s":5.725,"e":6.075},{"w":"about","s":6.075,"e":6.338},{"w":"the","s":6.338,"e":6.425},{"w":"plant","s":6.425,"e"