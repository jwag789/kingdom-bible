":0.688},{"w":"few","s":0.688,"e":0.875},{"w":"nights","s":0.875,"e":1.15},{"w":"later","s":1.15,"e":1.775},{"w":"Jesus","s":1.95,"e":2.438},{"w":"shared","s":2.438,"e":2.712},{"w":"a","s":2.712,"e":2.788},{"w":"special","s":2.788,"e":3.263},{"w":"supper","s":3.263,"e":3.625},{"w":"with","s":3.625,"e":3.763},{"w":"His","s":3.763,"e":3.95},{"w":"twelve","s":3.95,"e":4.287},{"w":"friends","s":4.287,"e":5},{"w":"the","s":5.1,"e":5.2},{"w":"disciples","s":5.2,"e":6.225}]},"supper-1":{"src":"audio/easter/supper-1.m4a","text":"Jesus took the bread, thanked God, and broke it. “This is My body, given for you,” He said. Then He shared a cup with them. “Remember Me when you do this.”","voice":"af_heart,af_bella","duration":11.275,"words":[{"w":"Jesus","s":0.65,"e":1.1},{"w":"took","s":1.1,"e":1.325},{"w":"the","s":1.325,"e":1.438},{"w":"bread","s":1.438,"e":1.95},{"w":"thanked","s":2.062,"e":2.462},{"w":"God","s":2.462,"e":2.875},{"w":"and","s":2.925,"e":3.05},{"w":"broke","s":3.05,"e":3.388},{"w":"it","s":3.388,"e":3.95},{"w":"This","s":4.15,"e":4.375},{"w":"is","s":4.375,"e":4.525},{"w":"My","s":4.525,"e":4.787},{"w":"body","s":4.787,"e":5.175},{"w":"given","s":5.225,"e":5.55},{"w":"for","s":5.55,"e":5.713},{"w":"you","s":5.713,"e":6.05},{"w":"He","s":6.2,"e":6.388},{"w":"said","s":6.388,"e":7},{"w":"Then","s":7.138,"e":7.312},{"w":"He","s":7.312,"e":7.463},{"w":"shared","s":7.463,"e":7.737},{"w":"a","s":7.737,"e":7.8},{"w":"cup","s":7.8,"e":8.037},{"w":"with","s":8.037,"e":8.175},{"w":"them","s":8.175,"e":8.8},{"w":"Remember","s":9.025,"e":9.475},{"w":"Me","s":9.475,"e":9.65},{"w":"when","s":9.65,"e":9.8},{"w":"you","s":9.8,"e":9.925},{"w":"do","s":9.925,"e":10.1},{"w":"this","s":10.1,"e":10.675}]},"supper-2":{"src":"audio/easter/supper-2.m4a","text":"Jesus knew that something very hard was coming. But He did not run away. He loved His friends, and He loved the whole world, so very much.","voice":"af_heart,af_bella","duration":10.375,"words":[{"w":"Jesus","s":0.65,"e":1.11