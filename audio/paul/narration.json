},{"w":"the","s":8.262,"e":8.35},{"w":"ground","s":8.35,"e":9.2}]},"light-1":{"src":"audio/paul/light-1.m4a","text":"A voice said, “Saul, Saul, why are you hurting Me?” “Who are You, Lord?” Saul asked. “I am Jesus,” said the voice.","voice":"af_heart,af_bella","duration":8.625,"words":[{"w":"A","s":0.625,"e":0.7},{"w":"voice","s":0.7,"e":1},{"w":"said","s":1,"e":1.3},{"w":"Saul","s":1.45,"e":1.75},{"w":"Saul","s":1.8,"e":2.1},{"w":"why","s":2.15,"e":2.288},{"w":"are","s":2.288,"e":2.375},{"w":"you","s":2.375,"e":2.475},{"w":"hurting","s":2.475,"e":2.85},{"w":"Me","s":2.85,"e":3.375},{"w":"Who","s":3.625,"e":3.75},{"w":"are","s":3.75,"e":3.85},{"w":"You","s":3.85,"e":4.025},{"w":"Lord","s":4.075,"e":4.575},{"w":"Saul","s":4.725,"e":5.037},{"w":"asked","s":5.037,"e":5.775},{"w":"I","s":6,"e":6.15},{"w":"am","s":6.15,"e":6.312},{"w":"Jesus","s":6.312,"e":6.975},{"w":"said","s":7.1,"e":7.263},{"w":"the","s":7.263,"e":7.35},{"w":"voice","s":7.35,"e":8.05}]},"light-2":{"src":"audio/paul/light-2.m4a","text":"When Saul got up, he couldn’t see a thing! His friends had to lead him by the hand into the city.","voice":"af_heart,af_bella","duration":6.825,"words":[{"w":"When","s":0.6,"e":0.787},{"w":"Saul","s":0.787,"e":1.1},{"w":"got","s":1.1,"e":1.3},{"w":"up","s":1.3,"e":1.7},{"w":"he","s":1.8,"e":1.95},{"w":"couldn't","s":1.95,"e":2.175},{"w":"see","s":2.175,"e":2.375},{"w":"a","s":2.375,"e":2.487},{"w":"thing","s":2.487,"e":3.2},{"w":"His","s":3.375,"e":3.575},{"w":"friends","s":3.575,"e":3.9},{"w":"had","s":3.9,"e":4.075},{"w":"to","s":4.075,"e":4.2},{"w":"lead","s":4.2,"e":4.388},{"w":"him","s":4.388,"e":4.575},{"w":"by","s":4.575,"e":4.713},{"w":"the","s":4.713,"e":4.8},{"w":"hand","s":4.8,"e":5.162},{"w":"into","s":5.162,"e":5.375},{"w":"the","s":5.375,"e":5.513},{"w":"city","s":5.513,"e":6.25}]},"see-title":{"src":"audio/paul/see-title.m4a","text":"Part Three. Saul Can See!.","voice":"af_heart,af_bella","duration":3.125,"words":[{"w":"Part","s":0.6,"e":0.875},{"w":"Thr