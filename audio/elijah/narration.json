,"s":1.863,"e":2.312},{"w":"called","s":2.312,"e":2.688},{"w":"all","s":2.688,"e":2.938},{"w":"the","s":2.938,"e":3.025},{"w":"people","s":3.025,"e":3.4},{"w":"to","s":3.4,"e":3.487},{"w":"the","s":3.487,"e":3.587},{"w":"top","s":3.587,"e":3.888},{"w":"of","s":3.888,"e":4},{"w":"Mount","s":4,"e":4.225},{"w":"Carmel","s":4.225,"e":4.975},{"w":"along","s":5.112,"e":5.463},{"w":"with","s":5.463,"e":5.65},{"w":"450","s":5.65,"e":6.7},{"w":"prophets","s":6.7,"e":7.162},{"w":"of","s":7.162,"e":7.275},{"w":"Baal","s":7.275,"e":8.2},{"w":"Let's","s":8.5,"e":8.75},{"w":"find","s":8.75,"e":9.062},{"w":"out","s":9.062,"e":9.275},{"w":"who","s":9.275,"e":9.425},{"w":"the","s":9.425,"e":9.562},{"w":"real","s":9.562,"e":9.85},{"w":"God","s":9.85,"e":10.213},{"w":"is","s":10.213,"e":10.725},{"w":"he","s":10.875,"e":11.037},{"w":"said","s":11.037,"e":11.65}]},"carmel-1":{"src":"audio/elijah/carmel-1.m4a","text":"“We will each build an altar and pray. The God who answers with fire is the real God!” Everyone agreed.","voice":"af_heart,af_bella","duration":7.7,"words":[{"w":"We","s":0.6,"e":0.7},{"w":"will","s":0.7,"e":0.875},{"w":"each","s":0.875,"e":1.125},{"w":"build","s":1.125,"e":1.363},{"w":"an","s":1.363,"e":1.488},{"w":"altar","s":1.488,"e":1.9},{"w":"and","s":1.9,"e":2.025},{"w":"pray","s":2.025,"e":2.6},{"w":"The","s":2.725,"e":2.85},{"w":"God","s":2.85,"e":3.138},{"w":"who","s":3.138,"e":3.288},{"w":"answers","s":3.288,"e":3.737},{"w":"with","s":3.737,"e":3.913},{"w":"fire","s":3.913,"e":4.325},{"w":"is","s":4.325,"e":4.475},{"w":"the","s":4.475,"e":4.612},{"w":"real","s":4.612,"e":4.925},{"w":"God","s":4.925,"e":5.625},{"w":"Everyone","s":5.812,"e":6.275},{"w":"agreed","s":6.275,"e":7.1}]},"carmel-2":{"src":"audio/elijah/carmel-2.m4a","text":"The prophets of Baal shouted and danced around their altar from morning until afternoon. “O Baal, answer us!” But nothing happened. Not a sound. Not one spark.","voice":"af_heart,af_bella","duration":12,"words":[{"w":"The","s":0.575,"