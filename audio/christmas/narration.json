":9.2,"words":[{"w":"So","s":0.6,"e":0.688},{"w":"they","s":0.688,"e":0.838},{"w":"stayed","s":0.838,"e":1.188},{"w":"in","s":1.188,"e":1.262},{"w":"a","s":1.262,"e":1.325},{"w":"place","s":1.325,"e":1.663},{"w":"where","s":1.663,"e":1.788},{"w":"the","s":1.788,"e":1.938},{"w":"animals","s":1.938,"e":2.413},{"w":"slept","s":2.413,"e":3.3},{"w":"And","s":3.425,"e":3.6},{"w":"there","s":3.6,"e":4.1},{"w":"that","s":4.225,"e":4.45},{"w":"very","s":4.45,"e":4.725},{"w":"night","s":4.725,"e":5.15},{"w":"Mary's","s":5.237,"e":5.625},{"w":"baby","s":5.625,"e":6},{"w":"was","s":6,"e":6.188},{"w":"born","s":6.188,"e":6.638},{"w":"Jesus","s":6.713,"e":7.325},{"w":"the","s":7.4,"e":7.537},{"w":"Son","s":7.537,"e":7.763},{"w":"of","s":7.763,"e":7.875},{"w":"God","s":7.875,"e":8.6}]},"birth-2":{"src":"audio/christmas/birth-2.m4a","text":"Mary wrapped Him snugly in soft cloths and laid Him in a manger, the wooden box where the animals ate their hay.","voice":"af_heart,af_bella","duration":8.4,"words":[{"w":"Mary","s":0.65,"e":0.975},{"w":"wrapped","s":0.975,"e":1.262},{"w":"Him","s":1.262,"e":1.488},{"w":"snugly","s":1.488,"e":2.05},{"w":"in","s":2.05,"e":2.212},{"w":"soft","s":2.212,"e":2.6},{"w":"cloths","s":2.6,"e":3.45},{"w":"and","s":3.45,"e":3.6},{"w":"laid","s":3.6,"e":3.837},{"w":"Him","s":3.837,"e":3.987},{"w":"in","s":3.987,"e":4.062},{"w":"a","s":4.062,"e":4.125},{"w":"manger","s":4.125,"e":4.925},{"w":"the","s":5.05,"e":5.188},{"w":"wooden","s":5.188,"e":5.5},{"w":"box","s":5.5,"e":5.963},{"w":"where","s":5.963,"e":6.088},{"w":"the","s":6.088,"e":6.237},{"w":"animals","s":6.237,"e":6.725},{"w":"ate","s":6.725,"e":6.925},{"w":"their","s":6.925,"e":7.125},{"w":"hay","s":7.125,"e":7.825}]},"shepherds-title":{"src":"audio/christmas/shepherds-title.m4a","text":"Part Four. Angels in the Sky.","voice":"af_heart,af_bella","duration":3.35,"words":[{"w":"Part","s":0.6,"e":0.85},{"w":"Four","s":0.85,"e":1.3},{"w":"Angels","s":1.438,"e":1.837},{"w":"in","s":1.837,"e":1.913},{"w":