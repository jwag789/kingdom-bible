ake","s":1.7,"e":2},{"w":"lied","s":2,"e":2.625},{"w":"If","s":2.825,"e":2.975},{"w":"you","s":2.975,"e":3.138},{"w":"eat","s":3.138,"e":3.35},{"w":"it","s":3.35,"e":3.45},{"w":"you'll","s":3.5,"e":3.612},{"w":"be","s":3.612,"e":3.75},{"w":"like","s":3.75,"e":3.975},{"w":"God","s":3.975,"e":4.7}]},"snake-2":{"src":"audio/garden/snake-2.m4a","text":"So Eve took the fruit and ate it, and gave some to Adam, and he ate it too.","voice":"af_heart,af_bella","duration":5.825,"words":[{"w":"So","s":0.625,"e":0.812},{"w":"Eve","s":0.812,"e":1.05},{"w":"took","s":1.05,"e":1.25},{"w":"the","s":1.25,"e":1.363},{"w":"fruit","s":1.363,"e":1.613},{"w":"and","s":1.613,"e":1.738},{"w":"ate","s":1.738,"e":1.975},{"w":"it","s":1.975,"e":2.325},{"w":"and","s":2.425,"e":2.55},{"w":"gave","s":2.55,"e":2.825},{"w":"some","s":2.825,"e":2.975},{"w":"to","s":2.975,"e":3.112},{"w":"Adam","s":3.112,"e":3.775},{"w":"and","s":3.9,"e":4.013},{"w":"he","s":4.013,"e":4.162},{"w":"ate","s":4.162,"e":4.375},{"w":"it","s":4.375,"e":4.537},{"w":"too","s":4.537,"e":5.225}]},"hiding-title":{"src":"audio/garden/hiding-title.m4a","text":"Part Five. Where Are You?.","voice":"af_heart,af_bella","duration":3,"words":[{"w":"Part","s":0.6,"e":0.875},{"w":"Five","s":0.875,"e":1.375},{"w":"Where","s":1.475,"e":1.613},{"w":"Are","s":1.613,"e":1.762},{"w":"You","s":1.762,"e":2.325}]},"hiding-0":{"src":"audio/garden/hiding-0.m4a","text":"That evening, they heard God walking in the garden — and they hid among the trees.","voice":"af_heart,af_bella","duration":5.825,"words":[{"w":"That","s":0.6,"e":0.825},{"w":"evening","s":0.825,"e":1.4},{"w":"they","s":1.5,"e":1.65},{"w":"heard","s":1.65,"e":1.938},{"w":"God","s":1.938,"e":2.312},{"w":"walking","s":2.312,"e":2.688},{"w":"in","s":2.688,"e":2.763},{"w":"the","s":2.763,"e":2.85},{"w":"garden","s":2.85,"e":3.513},{"w":"and","s":3.6,"e":3.712},{"w":"they","s":3.712,"e":3.862},{"w":"hid","s":3.862,"e":4.062},{"w":"among","s":4.062,"e":4.312},{"w":"the","s":4.312,"e":4.4},{"w":"trees","s":4.4,"e":5.25}]},"hiding-1":{"src":"audio/garden/hiding-1.m4a","text":"“Where are you?” God called. Adam said, “I was afraid, so I hid.” Their wrong choice had broken their friendship with God.","voice":"af_heart,af_bella","duration":8.875,"words":[{"w":"Where","s":0.65,"e":0.85},{"w":"are","s":0.85,"e":1.012},{"w":"you","s":1.012,"e":1.375},{"w":"God","s":1.55,"e":1.825},{"w":"called","s":1.825,"e":2.35},{"w":"Adam","s":2.487,"e":2.837},{"w":"said","s":2.837,"e":3.25},{"w":"I","s":3.4,"e":3.487},{"w":"was","s":3.487,"e":3.625},{"w":"afraid","s":3.625,"e":4.125},{"w":"so","s":4.175,"e":4.325},{"w":"I","s":4.325,"e":4.475},{"w":"hid","s":4.475,"e":5.225},{"w":"Their","s":5.463,"e":5.675},{"w":"wrong","s":5.675,"e":6.013},{"w":"choice","s":6.013,"e":6.338},{"w":"had","s":6.338,"e":6.45},{"w":"broken","s":6.45,"e":6.763},{"w":"their","s":6.763,"e":6.925},{"w":"friendship","s":6.925,"e":7.412},{"w":"with","s":7.412,"e":7.575},{"w":"God","s":7.575,"e":8.3}]},"promise-title":{"src":"audio/garden/promise-title.m4a","text":"Part Six. A Promise.","voice":"af_heart,af_bella","duration":3.025,"words":[{"w":"Part","s":0.6,"e":0.887},{"w":"Six","s":0.887,"e":1.375},{"w":"A","s":1.475,"e":1.575},{"w":"Promise","s":1.575,"e":2.425}]},"promise-0":{"src":"audio/garden/promise-0.m4a","text":"Sin had come into the world, and Adam and Eve had to leave the garden. But God still loved them. He even made them warm clothes to wear.","voice":"af_heart,af_bella","duration":10,"words":[{"w":"Sin","s":0.65,"e":0.9},{"w":"had","s":0.9,"e":1.075},{"w":"come","s":1.075,"e":1.262},{"w":"into","s":1.262,"e":1.438},{"w":"the","s":1.438,"e":1.525},{"w":"world","s":1.525,"e":2.175},{"w":"and","s":2.275,"e":2.45},{"w":"Adam","s":2.45,"e":2.825},{"w":"and","s":2.825,"e":2.962},{"w":"Eve","s":2.962,"e":3.275},{"w":"had","s":3.275,"e":3.475},{"w":"to","s":3.475,"e":3.6},{"w":"leave","s":3.6,"e":3.875},{"w":"the","s":3.875,"e":3.975},{"w":"garden","s":3.975,"e":4.9},{"w":"But","s":5.037,"e":5.213},{"w":"God","s":5.213,"e":5.662},{"w":"still","s":5.662,"e":6.013},{"w":"loved","s":6.013,"e":6.325},{"w":"them","s":6.325,"e":6.825},{"w":"He","s":6.925,"e":7.075},{"w":"even","s":7.075,"e":7.35},{"w":"made","s":7.35,"e":7.537},{"w":"them","s":7.537,"e":7.75},{"w":"warm","s":7.75,"e":8.15},{"w":"clothes","s":8.15,"e":8.575},{"w":"to","s":8.575,"e":8.7},{"w":"wear","s":8.7,"e":9.425}]},"promise-1":{"src":"audio/garden/promise-1.m4a","text":"And God made a promise: one day, a child would be born who would crush the snake’s head and make everything right again. That child would be Jesus.","voice":"af_heart,af_bella","duration":10.6,"words":[{"w":"And","s":0.6,"e":0.762},{"w":"God","s":0.762,"e":1.175},{"w":"made","s":1.175,"e":1.363},{"w":"a","s":1.363,"e":1.425},{"w":"promise","s":1.425,"e":2.25},{"w":"one","s":2.388,"e":2.65},{"w":"day","s":2.65,"e":3.1},{"w":"a","s":3.212,"e":3.35},{"w":"child","s":3.35,"e":3.737},{"w":"would","s":3.737,"e":3.837},{"w":"be","s":3.837,"e":3.987},{"w":"born","s":3.987,"e":4.4},{"w":"who","s":4.4,"e":4.513},{"w":"would","s":4.513,"e":4.662},{"w":"crush","s":4.662,"e":5},{"w":"the","s":5,"e":5.138},{"w":"snake's","s":5.138,"e":5.575},{"w":"head","s":5.575,"e":6.013},{"w":"and","s":6.013,"e":6.138},{"w":"make","s":6.138,"e":6.362},{"w":"everything","s":6.362,"e":6.9},{"w":"right","s":6.9,"e":7.125},{"w":"again","s":7.125,"e":7.95},{"w":"That","s":8.175,"e":8.5},{"w":"child","s":8.5,"e":8.912},{"w":"would","s":8.912,"e":9.012},{"w":"be","s":9.012,"e":9.162},{"w":"Jesus","s":9.162,"e":10.025}]},"talk":{"src":"audio/garden/talk.m4a","text":"Let’s talk about it. Why do you think Adam and Eve hid from God? Have you ever done something wrong and wanted to hide? What helps you say sorry? God still loved Adam and Eve, and made them a promise. How does God show us He loves us? Our memory verse is Genesis 3, verse 9. But the Lord God called out to the man, “Where are you?”","voice":"af_heart,af_bella","duration":21.65,"words":[{"w":"Let's","s":0.6,"e":0.85},{"w":"talk","s":0.85,"e":1.087},{"w":"about","s":1.087,"e":1.375},{"w":"it","s":1.375,"e":1.825},{"w":"Why","s":1.938,"e":2.087},{"w":"do","s":2.087,"e":2.188},{"w":"you","s":2.188,"e":2.275},{"w":"think","s":2.275,"e":2.513},{"w":"Adam","s":2.513,"e":2.812},{"w":"and","s":2.812,"e":2.938},{"w":"Eve","s":2.938,"e":3.25},{"w":"hid","s":3.25,"e":3.475},{"w":"from","s":3.475,"e":3.675},{"w":"God","s":3.675,"e":4.4},{"w":"Have","s":4.525,"e":4.662},{"w":"you","s":4.662,"e":4.775},{"w":"ever","s":4.775,"e":5},{"w":"done","s":5,"e":5.225},{"w":"something","s":5.225,"e":5.55},{"w":"wrong","s":5.55,"e":5.888},{"w":"and","s":5.888,"e":6},{"w":"wanted","s":6,"e":6.25},{"w":"to","s":6.25,"e":6.375},{"w":"hide","s":6.375,"e":7},{"w":"What","s":7.1,"e":7.237},{"w":"helps","s":7.237,"e":7.5},{"w":"you","s":7.5,"e":7.638},{"w":"say","s":7.638,"e":7.912},{"w":"sorry","s":7.912,"e":8.575},{"w":"God","s":8.75,"e":9.125},{"w":"still","s":9.125,"e":9.4},{"w":"loved","s":9.4,"e":9.713},{"w":"Adam","s":9.713,"e":10.012},{"w":"and","s":10.012,"e":10.137},{"w":"Eve","s":10.137,"e":10.5},{"w":"and","s":10.55,"e":10.675},{"w":"made","s":10.675,"e":10.863},{"w":"them","s":10.863,"e":10.988},{"w":"a","s":10.988,"e":11.05},{"w":"promise","s":11.05,"e":12.025},{"w":"How","s":12.2,"e":12.4},{"w":"does","s":12.4,"e":12.625},{"w":"God","s":12.625,"e":13},{"w":"show","s":13,"e":13.238},{"w":"us","s":13.238,"e":13.375},{"w":"He","s":13.375,"e":13.525},{"w":"loves","s":13.525,"e":13.762},{"w":"us","s":13.762,"e":14.275},{"w":"Our","s":14.375,"e":14.537},{"w":"memory","s":14.537,"e":14.975},{"w":"verse","s":14.975,"e":15.275},{"w":"is","s":15.275,"e":15.438},{"w":"Genesis","s":15.438,"e":16.075},{"w":"3","s":16.075,"e":16.525},{"w":"verse","s":16.6,"e":16.925},{"w":"9","s":16.925,"e":17.675},{"w":"But","s":17.775,"e":17.913},{"w":"the","s":17.913,"e":18.038},{"w":"Lord","s":18.038,"e":18.375},{"w":"God","s":18.375,"e":18.738},{"w":"called","s":18.738,"e":19.012},{"w":"out","s":19.012