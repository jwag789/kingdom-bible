.21}, {"w": "and", "s": 1.21, "e": 1.427}, {"w": "Ruth", "s": 1.427, "e": 1.79}, {"w": "walked", "s": 1.79, "e": 2.224}, {"w": "all", "s": 2.224, "e": 2.514}, {"w": "the", "s": 2.514, "e": 2.659}, {"w": "way", "s": 2.659, "e": 2.949}, {"w": "to", "s": 2.949, "e": 3.167}, {"w": "Bethlehem", "s": 3.167, "e": 3.819}, {"w": "They", "s": 3.819, "e": 4.036}, {"w": "got", "s": 4.036, "e": 4.399}, {"w": "there", "s": 4.399, "e": 4.688}, {"w": "just", "s": 4.688, "e": 5.123}, {"w": "as", "s": 5.123, "e": 5.268}, {"w": "the", "s": 5.268, "e": 5.413}, {"w": "barley", "s": 5.413, "e": 5.921}, {"w": "harvest", "s": 5.921, "e": 6.573}, {"w": "was", "s": 6.573, "e": 6.79}, {"w": "beginning", "s": 6.79, "e": 7.37}]}, "field-1": {"src": "audio/ruth/field-1.m4a", "text": "They had no food, so Ruth went to the fields to glean. That means she walked behind the workers and picked up the grain they dropped.", "voice": "af_heart,af_bella", "duration": 9.178, "words": [{"w": "They", "s": 0.64, "e": 0.835}, {"w": "had", "s": 0.835, "e": 1.095}, {"w": "no", "s": 1.095, "e": 1.355}, {"w": "food", "s": 1.355, "e": 1.68}, {"w": "so", "s": 2.01, "e": 2.241}, {"w": "Ruth", "s": 2.241, "e": 2.529}, {"w": "went", "s": 2.529, "e": 2.818}, {"w": "to", "s": 2.818, "e": 2.991}, {"w": "the", "s": 2.991, "e": 3.107}, {"w": "fields", "s": 3.107, "e": 3.511}, {"w": "to", "s": 3.511, "e": 3.684}, {"w": "glean", "s": 3.684, "e": 4.03}, {"w": "That", "s": 4.71, "e": 4.957}, {"w": "means", "s": 4.957, "e": 5.328}, {"w": "she", "s": 5.328, "e": 5.514}, {"w": "walked", "s": 5.514, "e": 5.885}, {"w": "behind", "s": 5.885, "e": 6.38}, {"w": "the", "s": 6.38, "e": 6.504}, {"w": "workers", "s": 6.504, "e": 6.936}, {"w": "and", "s": 6.936, "e": 7.122}, {"w": "picked", "s": 7.122, "e": 7.431}, {"w": "up", "s": 7.431, "e": 7.617}, {"w": "the", "s": 7.617, "e": 7.74}, {"w": "grain", "s": 7.74, "e": 8.112}, {"w": "they", "s": 8.112, "e": 8.297}, {"w": "dropped", "s": 8.297, "e": 8.73}]}, "field-2": {"src": "audio/ruth/fi