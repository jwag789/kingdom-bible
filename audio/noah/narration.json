ion":6.45,"words":[{"w":"So","s":0.625,"e":0.8},{"w":"Noah","s":0.8,"e":1.125},{"w":"did","s":1.125,"e":1.275},{"w":"everything","s":1.275,"e":1.8},{"w":"just","s":1.8,"e":2.05},{"w":"as","s":2.05,"e":2.212},{"w":"God","s":2.212,"e":2.525},{"w":"told","s":2.525,"e":2.812},{"w":"him","s":2.812,"e":3.4},{"w":"Day","s":3.575,"e":3.825},{"w":"after","s":3.825,"e":4.1},{"w":"day","s":4.1,"e":4.55},{"w":"he","s":4.65,"e":4.8},{"w":"built","s":4.8,"e":5.1},{"w":"and","s":5.1,"e":5.225},{"w":"built","s":5.225,"e":5.875}]},"animals-title":{"src":"audio/noah/animals-title.m4a","text":"Part Three. Two by Two.","voice":"af_heart,af_bella","duration":3.125,"words":[{"w":"Part","s":0.6,"e":0.887},{"w":"Three","s":0.887,"e":1.325},{"w":"Two","s":1.462,"e":1.675},{"w":"by","s":1.675,"e":1.9},{"w":"Two","s":1.9,"e":2.5}]},"animals-0":{"src":"audio/noah/animals-0.m4a","text":"When the ark was ready, the animals came — two by two, every kind: lions and lambs, elephants and mice, and birds of every color.","voice":"af_heart,af_bella","duration":10.15,"words":[{"w":"When","s":0.575,"e":0.688},{"w":"the","s":0.688,"e":0.8},{"w":"ark","s":0.8,"e":1.038},{"w":"was","s":1.038,"e":1.2},{"w":"ready","s":1.2,"e":1.675},{"w":"the","s":1.775,"e":1.925},{"w":"animals","s":1.925,"e":2.4},{"w":"came","s":2.4,"e":2.775},{"w":"two","s":2.85,"e":3.05},{"w":"by","s":3.05,"e":3.263},{"w":"two","s":3.263,"e":3.575},{"w":"every","s":3.65,"e":3.95},{"w":"kind","s":3.95,"e":4.85},{"w":"lions","s":5.05,"e":5.625},{"w":"and","s":5.625,"e":5.75},{"w":"lambs","s":5.75,"e":6.375},{"w":"elephants","s":6.487,"e":7.05},{"w":"and","s":7.05,"e":7.175},{"w":"mice","s":7.175,"e":7.775},{"w":"and","s":7.85,"e":8.012},{"w":"birds","s":8.012,"e":8.412},{"w":"of","s":8.412,"e":8.525},{"w":"every","s":8.525,"e":8.85},{"w":"color","s":8.85,"e":9.575}]},"animals-1":{"src":"audio/noah/animals-1.m4a","text":"Noah and his family went inside with them all. And then God Himself shut the door.","voice":"af_heart,af_bella","duration":6.25,"words":[{"w":"Noah","s":0.675,"e":0.975},{"w":"and","s":0.975,"e":1.087},{"w":"his","s":1.087,"e":1.25},{"w":"family","s":1.25,"e":1.725},{"w":"went","s":1.725,"e":1.9},{"w":"inside","s":1.9,"e":2.362},{"w":"with","s":2.362,"e":2.487},{"w":"them","s":2.487,"e":2.65},{"w":"all","s":2.65,"e":3.3},{"w":"And","s":3.425,"e":3.562},{"w":"then","s":3.562,"e":3.825},{"w":"God","s":3.825,"e":4.138},{"w":"Himself","s":4.138,"e":4.638},{"w":"shut","s":4.638,"e":4.875},{"w":"the","s":4.875,"e":4.975},{"w":"door","s":4.975,"e":5.675}]},"flood-title":{"src":"audio/noah/flood-title.m4a","text":"Part Four. The Rain Came.","voice":"af_heart,af_bella","duration":3.075,"words":[{"w":"Part","s":0.6,"e":0.85},{"w":"Four","s":0.85,"e":1.275},{"w":"The","s":1.4,"e":1.5},{"w":"Rain","s":1.5,"e":1.8},{"w":"Came","s":1.8,"e":2.475}]},"flood-0":{"src":"audio/noah/flood-0.m4a","text":"Then the rain began. It rained for forty days and forty nights. Springs burst up from deep below, and the water rose, and rose, and rose.","voice":"af_heart,af_bella","duration":10.775,"words":[{"w":"Then","s":0.6,"e":0.762},{"w":"the","s":0.762,"e":0.85},{"w":"rain","s":0.85,"e":1.175},{"w":"began","s":1.175,"e":2},{"w":"It","s":2.125,"e":2.3},{"w":"rained","s":2.3,"e":2.65},{"w":"for","s":2.65,"e":2.825},{"w":"forty","s":2.825,"e":3.175},{"w":"days","s":3.175,"e":3.6},{"w":"and","s":3.6,"e":3.737},{"w":"forty","s":3.737,"e":4.075},{"w":"nights","s":4.075,"e":4.95},{"w":"Springs","s":5.138,"e":5.713},{"w":"burst","s":5.713,"e":6.037},{"w":"up","s":6.037,"e":6.225},{"w":"from","s":6.225,"e":6.438},{"w":"deep","s":6.438,"e":6.7},{"w":"below","s":6.7,"e":7.325},{"w":"and","s":7.425,"e":7.537},{"w":"the","s":7.537,"e":7.625},{"w":"water","s":7.625,"e":8.012},{"w":"rose","s":8.012,"e":8.5},{"w":"and","s":8.55,"e":8.713},{"w":"rose","s":8.713,"e":9.225},{"w":"and","s":9.275,"e":9.4},{"w":"rose","s":9.4,"e":10.2}]},"flood-1":{"src":"audio/noah/flood-1.m4a","text":"The water covered the hills, and then even the 