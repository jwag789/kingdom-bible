9.55}]},"morning-title":{"src":"audio/daniel/morning-title.m4a","text":"Part Five. Safe!.","voice":"af_heart,af_bella","duration":2.7,"words":[{"w":"Part","s":0.625,"e":0.9},{"w":"Five","s":0.9,"e":1.275},{"w":"Safe","s":1.375,"e":2.075}]},"morning-0":{"src":"audio/daniel/morning-0.m4a","text":"The king couldn’t sleep all night. At sunrise he ran to the den. “Daniel! Has your God saved you?”","voice":"af_heart,af_bella","duration":7.375,"words":[{"w":"The","s":0.6,"e":0.7},{"w":"king","s":0.7,"e":0.975},{"w":"couldn't","s":0.975,"e":1.2},{"w":"sleep","s":1.2,"e":1.438},{"w":"all","s":1.438,"e":1.625},{"w":"night","s":1.625,"e":2.275},{"w":"At","s":2.375,"e":2.587},{"w":"sunrise","s":2.587,"e":3.15},{"w":"he","s":3.15,"e":3.3},{"w":"ran","s":3.3,"e":3.55},{"w":"to","s":3.55,"e":3.638},{"w":"the","s":3.638,"e":3.725},{"w":"den","s":3.725,"e":4.4},{"w":"Daniel","s":4.625,"e":5.2},{"w":"Has","s":5.275,"e":5.463},{"w":"your","s":5.463,"e":5.575},{"w":"God","s":5.575,"e":5.938},{"w":"saved","s":5.938,"e":6.3},{"w":"you","s":6.3,"e":6.75}]},"morning-1":{"src":"audio/daniel/morning-1.m4a","text":"“My God sent His angel and shut the mouths of the lions!” Daniel called. “They haven’t hurt me one bit!” The king was so happy!","voice":"af_heart,af_bella","duration":9.175,"words":[{"w":"My","s":0.65,"e":0.8},{"w":"God","s":0.8,"e":1.137},{"w":"sent","s":1.137,"e":1.363},{"w":"His","s":1.363,"e":1.55},{"w":"angel","s":1.55,"e":1.975},{"w":"and","s":1.975,"e":2.125},{"w":"shut","s":2.125,"e":2.375},{"w":"the","s":2.375,"e":2.475},{"w":"mouths","s":2.475,"e":2.837},{"w":"of","s":2.837,"e":2.913},{"w":"the","s":2.913,"e":3.025},{"w":"lions","s":3.025,"e":3.8},{"w":"Daniel","s":3.975,"e":4.4},{"w":"called","s":4.4,"e":5.025},{"w":"They","s":5.225,"e":5.375},{"w":"haven't","s":5.375,"e":5.675},{"w":"hurt","s":5.675,"e":5.888},{"w":"me","s":5.888,"e":6.025},{"w":"one","s":6.025,"e":6.25},{"w":"bit","s":6.25,"e":6.95},{"w":"The","s":7.1,"e":7.237},{"w":"king","s":7.237,"e":7.5},{"w":"was","s":7.5,"e":7.65},{"w":"so","s":7.65,"e":7.85},{"w":"happy","s":7.85,"e":8.6}]},"morning-2":{"src":"audio/daniel/morning-2.m4a","text":"Daniel came out without a single scratch, because he trusted God. And King Darius told the whole land, “Daniel’s God is the living God. He rescues and He saves!”","voice":"af_heart,af_bella","duration":12.075,"words":[{"w":"Daniel","s":0.65,"e":1.05},{"w":"came","s":1.05,"e":1.3},{"w":"out","s":1.3,"e":1.525},{"w":"without","s":1.525,"e":1.837},{"w":"a","s":1.837,"e":1.95},{"w":"single","s":1.95,"e":2.362},{"w":"scratch","s":2.362,"e":2.975},{"w":"because","s":3.05,"e":3.312},{"w":"he","s":3.312,"e":3.425},{"w":"trusted","s":3.425,"e":3.888},{"w":"God","s":3.888,"e":4.775},{"w":"And","s":4.9,"e":5.088},{"w":"King","s":5.088,"e":5.35},{"w":"Darius","s":5.35,"e":5.825},{"w":"told","s":5.825,"e":6.088},{"w":"the","s":6.088,"e":6.175},{"w":"whole","s":6.175,"e":6.425},{"w":"land","s":6.425,"e":7.125},{"w":"Daniel's","s":7.325,"e":7.787},{"w":"God","s":7.787,"e":8.2},{"w":"is","s":8.2,"e":8.35},{"w":"the","s":8.35,"e":8.475},{"w":"living","s":8.475,"e":8.825},{"w":"God","s":8.825,"e":9.475},{"w":"He","s":9.575,"e":9.725},{"w":"rescues","s":9.725,"e":10.35},{"w":"and","s":10.35,"e":10.463},{"w":"He","s":10.463,"e":10.625},{"w":"saves","s":10.625,"e":11.475}]},"talk":{"src":"audio/daniel/talk.m4a","text":"Let’s talk about it. Daniel kept praying even when there was a rule against it. Why do you think he did? How do you think Daniel felt down in the den with the lions? When and where can you talk to God? Our memory verse is Daniel 6, verse 22. My God sent His angel and shut the mouths of the lions.","voice":"af_heart,af_bella","duration":19.95,"words":[{"w":"Let's","s":0.625,"e":0.875},{"w":"talk","s":0.875,"e":1.113},{"w":"about","s":1.113,"e":1.4},{"w":"it","s":1.4,"e":1.85},{"w":"Daniel","s":1.988,"e":2.425},{"w":"kept","s":2.425,"e":2.675},{"w":"praying","s":2.675,"e":3.062},{"w":"even","s":3.062,"e":3.413},{"w":"when","s":3.413,"e":