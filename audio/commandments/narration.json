ghtning","s":4.825,"e":5.575},{"w":"a","s":5.713,"e":5.862},{"w":"thick","s":5.862,"e":6.188},{"w":"dark","s":6.188,"e":6.537},{"w":"cloud","s":6.537,"e":7.325},{"w":"and","s":7.425,"e":7.537},{"w":"the","s":7.537,"e":7.638},{"w":"sound","s":7.638,"e":7.963},{"w":"of","s":7.963,"e":8.037},{"w":"a","s":8.037,"e":8.113},{"w":"trumpet","s":8.113,"e":8.65},{"w":"that","s":8.65,"e":8.8},{"w":"grew","s":8.8,"e":9.075},{"w":"louder","s":9.075,"e":9.525},{"w":"and","s":9.525,"e":9.65},{"w":"LOUDER","s":9.65,"e":10.35}]},"thunder-1":{"src":"audio/commandments/thunder-1.m4a","text":"God came down on the mountain in fire, and it smoked like a giant oven. The people trembled. But Moses climbed up the mountain to meet with God.","voice":"af_heart,af_bella","duration":10.3,"words":[{"w":"God","s":0.65,"e":0.975},{"w":"came","s":0.975,"e":1.275},{"w":"down","s":1.275,"e":1.538},{"w":"on","s":1.538,"e":1.637},{"w":"the","s":1.637,"e":1.725},{"w":"mountain","s":1.725,"e":2.15},{"w":"in","s":2.15,"e":2.312},{"w":"fire","s":2.312,"e":2.95},{"w":"and","s":3.05,"e":3.163},{"w":"it","s":3.163,"e":3.337},{"w":"smoked","s":3.337,"e":3.8},{"w":"like","s":3.8,"e":3.962},{"w":"a","s":3.962,"e":4.075},{"w":"giant","s":4.075,"e":4.5},{"w":"oven","s":4.5,"e":5.25},{"w":"The","s":5.412,"e":5.525},{"w":"people","s":5.525,"e":5.912},{"w":"trembled","s":5.912,"e":6.775},{"w":"But","s":6.888,"e":7.062},{"w":"Moses","s":7.062,"e":7.562},{"w":"climbed","s":7.562,"e":7.888},{"w":"up","s":7.888,"e":7.987},{"w":"the","s":7.987,"e":8.075},{"w":"mountain","s":8.075,"e":8.475},{"w":"to","s":8.475,"e":8.6},{"w":"meet","s":8.6,"e":8.787},{"w":"with","s":8.787,"e":8.95},{"w":"God","s":8.95,"e":9.7}]},"tablets-title":{"src":"audio/commandments/tablets-title.m4a","text":"Part Three. Ten Good Rules.","voice":"af_heart,af_bella","duration":3.275,"words":[{"w":"Part","s":0.6,"e":0.875},{"w":"Three","s":0.875,"e":1.3},{"w":"Ten","s":1.438,"e":1.7},{"w":"Good","s":1.7,"e":1.9},{"w":"Rules","s":1.9,"e":2.7}]},"tablets-0":{"src":"audio/commandments/tablets-0.m4a","text":"Up on the mountain, God gave Moses ten good rules, called the Ten Commandments. God wrote them with His own finger, on two tablets of stone!","voice":"af_heart,af_bella","duration":10.375,"words":[{"w":"Up","s":0.6,"e":0.738},{"w":"on","s":0.738,"e":0.838},{"w":"the","s":0.838,"e":0.925},{"w":"mountain","s":0.925,"e":1.625},{"w":"God","s":1.762,"e":2.125},{"w":"gave","s":2.125,"e":2.375},{"w":"Moses","s":2.375,"e":2.862},{"w":"ten","s":2.862,"e":3.125},{"w":"good","s":3.125,"e":3.35},{"w":"rules","s":3.35,"e":3.975},{"w":"called","s":4.075,"e":4.338},{"w":"the","s":4.338,"e":4.438},{"w":"Ten","s":4.438,"e":4.7},{"w":"Commandments","s":4.7,"e":5.825},{"w":"God","s":6,"e":6.325},{"w":"wrote","s":6.325,"e":6.513},{"w":"them","s":6.513,"e":6.688},{"w":"with","s":6.688,"e":6.812},{"w":"His","s":6.812,"e":7},{"w":"own","s":7,"e":7.287},{"w":"finger","s":7.287,"e":7.85},{"w":"on","s":7.95,"e":8.162},{"w":"two","s":8.162,"e":8.412},{"w":"tablets","s":8.412,"e":8.887},{"w":"of","s":8.887,"e":9},{"w":"stone","s":9,"e":9.8}]},"tablets-1":{"src":"audio/commandments/tablets-1.m4a","text":"Love God more than anything. Don’t make idols to bow down to. Say God’s name with love and respect. And keep one day each week special, for resting and for God.","voice":"af_heart,af_bella","duration":12.4,"words":[{"w":"Love","s":0.675,"e":0.963},{"w":"God","s":0.963,"e":1.325},{"w":"more","s":1.325,"e":1.512},{"w":"than","s":1.512,"e":1.625},{"w":"anything","s":1.625,"e":2.45},{"w":"Don't","s":2.587,"e":2.788},{"w":"make","s":2.788,"e":3.013},{"w":"idols","s":3.013,"e":3.475},{"w":"to","s":3.475,"e":3.575},{"w":"bow","s":3.575,"e":3.8},{"w":"down","s":3.8,"e":4.138},{"w":"to","s":4.138,"e":4.55},{"w":"Say","s":4.938,"e":5.237},{"w":"God's","s":5.237,"e":5.675},{"w":"name","s":5.675,"e":5.975},{"w":"with","s":5.975,"e":6.175},{"w":"love","s":6.175,"e":6.625},{"w":"and","s":6.625,"e":6.737},{"w":"respect","s":6.737,"e":7.65},{"w":"And","s":7.75,"e":7.9},{"w":"keep","s":7.9,"e":8.137},{"w":"one","s":8.137,"e":8.375},{"w":"day","s":8.375,"e":8.688},{"w":"each","s":8.688,"e":9.012},{"w":"week","s":9.012,"e":9.275},{"w":"special","s":9.275,"e":9.925},{"w":"for","s":10.025,"e":10.175},{"w":"resting","s":10.175,"e":10.762},{"w":"and","s":10.762,"e":10.9},{"w":"for","s":10.9,"e":11.05},{"w":"God","s":11.05,"e":11.8}]},"tablets-2":{"src":"audio/commandments/tablets-2.m4a","text":"Honor your mom and dad. Don’t hurt anyone. Husbands and wives, stay true to each other. Don’t steal. Don’t lie. And don’t wish you had what belongs to someone else.","voice":"af_heart,af_bella","duration":11.725,"words":[{"w":"Honor","s":0.65,"e":0.95},{"w":"your","s":0.95,"e":1.1},{"w":"mom","s":1.1,"e":1.438},{"w":"and","s":1.438,"e":1.55},{"w":"dad","s":1.55,"e":2.2},{"w":"Don't","s":2.337,"e":2.575},{"w":"hurt","s":2.575,"e":2.8},{"w":"anyone","s":2.8,"e":3.6},{"w":"Husbands","s":3.737,"e":4.213},{"w":"and","s":4.213,"e":4.338},{"w":"wives","s":4.338,"e":4.85},{"w":"stay","s":4.912,"e":5.275},{"w":"true","s":5.275,"e":5.55},{"w":"to","s":5.55,"e":5.675},{"w":"each","s":5.675,"e":5.888},{"w":"other","s":5.888,"e":6.4},{"w":"Don't","s":6.537,"e":6.812},{"w":"steal","s":6.812,"e":7.475},{"w":"Don't","s":7.612,"e":7.85},{"w":"lie","s":7.85,"e":8.5},{"w":"And","s":8.625,"e":8.762},{"w":"don't","s":8.762,"e":8.925},{"w":"wish","s":8.925,"e":9.125},{"w":"you","s":9.125,"e":9.25},{"w":"had","s":9.25,"e":9.438},{"w":"what","s":9.438,"e":9.575},{"w":"belongs","s":9.575,"e":10.1},{"w":"to","s":10.1,"e":10.2},{"w":"someone","s":10.2,"e":10.463},{"w":"else","s":10.463,"e":11.15}]},"tablets-3":{"src":"audio/commandments/tablets-3.m4a","text":"God gave these rules because He loved His people. They show us how to love God, and how to love each other.","voice":"af_heart,af_bella","duration":7.825,"words":[{"w":"God","s":0.625,"e":0.925},{"w":"gave","s":0.925,"e":1.15},{"w":"these","s":1.15,"e":1.413},{"w":"rules","s":1.413,"e":1.925},{"w":"because","s":1.925,"e":2.188},{"w":"He","s":2.188,"e":2.337},{"w":"loved","s":2.337,"e":2.663},{"w":"His","s":2.663,"e":2.825},{"w":"people","s":2.825,"e":3.625},{"w":"They","s":3.788,"e":3.987},{"w":"show","s":3.987,"e":4.213},{"w":"us","s":4.213,"e":4.35},{"w":"how","s":4.35,"e":4.525},{"w":"to","s":4.525,"e":4.662},{"w":"love","s":4.662,"e":5.013},{"w":"God","s":5.013,"e":5.7},{"w":"and","s":5.8,"e":5.925},{"w":"how","s":5.925,"e":6.1},{"w":"to","s":6.1,"e":6.225},{"w":"love","s":6.225,"e":6.412},{"w":"each","s":6.412,"e":6.612},{"w":"other","s":6.612,"e":7.25}]},"calf-title":{"src":"audio/commandments/calf-title.m4a","text":"Part Four. The Golden Calf.","voice":"af_heart,af_bella","duration":3.175,"words":[{"w":"Part","s":0.6,"e":0.85},{"w":"Four","s":0.85,"e":1.275},{"w":"The","s":1.375,"e":1.475},{"w":"Golden","s":1.475,"e":1.863},{"w":"Calf","s":1.863,"e":2.575}]},"calf-0":{"src":"audio/commandments/calf-0.m4a","text":"Moses was up on the mountain for forty days. Down below, the people got tired of waiting. “Make us a god we can see!” they said to Aaron, Moses’ brother.","voice":"af_heart,af_bella","duration":11.225,"words":[{"w":"Moses","s":0.675,"e":1.125},{"w":"was","s":1.125,"e":1.262},{"w":"up","s":1.262,"e":1.413},{"w":"on","s":1.413,"e":1.512},{"w":"the","s":1.512,"e":1.6},{"w":"mountain","s":1.6,"e":2.025},{"w":"for","s":2.025,"e":2.188},{"w":"forty","s":2.188,"e":2.525},{"w":"days","s":2.525,"e":3.325},{"w":"Down","s":3.475,"e":3.8},{"w":"below","s":3.8,"e":4.25},{"w":"the","s":4.287,"e":4.375},{"w":"people","s":4.375,"e":4.7},{"w":"got","s":4.7,"e":4.938},{"w":"tired","s":4.938,"e":5.362},{"w":"of","s":5.362,"e":5.475},{"w":"waiting","s":5.475,"e":6.3},{"w":"Make","s":6.5,"e":6.662},{"w":"us","s":6.662,"e":6.825},{"w":"a","s":6.825,"e":6.938},{"w":"god","s":6.938,"e":7.3},{"w":"we","s":7.3,"e":7.425},{"w":"can","s":7.425,"e":7.65},{"w":"see","s":7.65,"e":8.2},{"w":"they","s":8.425,"e":8.575},{"w":"said","s":8.575,"e":8.8},{"w":"to","s":8.8,"e":8.938},{"w":"